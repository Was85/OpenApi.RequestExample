  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenApiExampleApp\OpenApiExampleApp.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
