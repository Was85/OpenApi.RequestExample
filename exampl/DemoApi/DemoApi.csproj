    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

	<PropertyGroup>
		<OpenApiGenerateDocumentsOptions>--file-name kalle</OpenApiGenerateDocumentsOptions>
